<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks><TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android</TargetFrameworks><TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks><TargetFrameworks Condition="'$(BigDaySortedTargetFramework)'!=''">$(BigDaySortedTargetFramework)</TargetFrameworks><OutputType>Exe</OutputType><RootNamespace>BigDaySorted.App</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AppBrand Condition="'$(AppBrand)'==''">BigDaySorted</AppBrand><AssemblyName>$(AppBrand).App</AssemblyName><ApplicationTitle>$(AppBrand)</ApplicationTitle><ApplicationId>com.keepmytravels.bigdaysorted</ApplicationId><ApplicationId Condition="'$(AppBrand)'=='LiveDaysSorted'">com.keepmytravels.livedayssorted</ApplicationId><Version>0.1.4</Version><ApplicationDisplayVersion>0.1.4</ApplicationDisplayVersion><ApplicationVersion>5</ApplicationVersion><WindowsPackageType>None</WindowsPackageType><PublishTrimmed>false</PublishTrimmed></PropertyGroup>
<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='android'"><SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion><AndroidPackageFormats>apk</AndroidPackageFormats><AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods><RunAOTCompilation>false</RunAOTCompilation></PropertyGroup>
<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='ios'"><SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion></PropertyGroup>
<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='maccatalyst'"><SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion><CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements></PropertyGroup>
<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))=='windows'"><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)'!=''">$(RuntimeIdentifierOverride)</RuntimeIdentifier></PropertyGroup>
<ItemGroup><MauiImage Include="Resources/Images/*"/><MauiIcon Include="Resources/AppIcon/appicon.svg"/><MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#12323e" BaseSize="128,128"/><MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/><PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90"/><PackageReference Include="QRCoder" Version="1.8.0"/><ProjectReference Include="../BigDaySorted.Core/BigDaySorted.Core.csproj"/></ItemGroup>
<Target Name="ValidateBrandPreparation" BeforeTargets="PrepareForBuild"><Error Condition="'$(AppBrand)'!='BigDaySorted' And '$(AppBrand)'!='LiveDaysSorted'" Text="Choose BigDaySorted or LiveDaysSorted."/><Error Condition="'$(AppBrand)'=='LiveDaysSorted' And '$(NativeBrandPrepared)'!='true'" Text="Use scripts/Build-* with Brand LiveDaysSorted, or prepare-native-brand.mjs first, so platform identities match the brand."/></Target></Project>
